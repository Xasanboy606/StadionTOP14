# Frontend (Vite) muhit o'zgaruvchilari — bu shablonni .env ga nusxalab, qiymatlarni to'ldiring
# DIQQAT: VITE_ prefiksli o'zgaruvchilar frontend bundle'iga kiradi va OMMAVIY bo'ladi.
# Hech qachon maxfiy kalitni VITE_ bilan qo'ymang!

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# TELEGRAM_BOT_TOKEN — bu MAXFIY. Frontend'da ishlatmang, faqat backend/serverda.
TELEGRAM_BOT_TOKEN=
